#!/usr/bin/env python3
"""
AgriSense AI - Weather Location Synchronization & Race Condition Tests
========================================================================
1. Backend Test:
   - Verify Hyderabad returns lat 17.3850, lon 78.4867 and city 'Hyderabad, Telangana'.
   - Verify Bengaluru returns lat 12.9716, lon 77.5946 and city 'Bengaluru, Karnataka'.
   - Verify coordinates are never Coimbatore or None in fallback baseline.

2. Playwright Frontend E2E Test:
   - Location switch: Click Hyderabad chip, verify heading 'Current Climate in Hyderabad',
     intercept /api/weather request, assert fallback banner displayed.
   - Rapid switch race condition: Click Hyderabad then immediately click Bengaluru,
     verify final settled state is strictly Bengaluru and not overwritten by Hyderabad.
"""

import os
import time
import subprocess
import urllib.request
import unittest
from unittest.mock import patch
import pytest
from playwright.sync_api import sync_playwright

from app import create_app
from app.services.weather_service import get_weather_data, WEATHER_CACHE

PROJECT_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "../.."))
VENV_PYTHON = os.path.join(PROJECT_ROOT, "venv/bin/python")


class BackendWeatherLocationSyncTestCase(unittest.TestCase):
    def setUp(self):
        WEATHER_CACHE.clear()

    def test_hyderabad_and_bengaluru_fallback_coordinates_and_city(self):
        """
        Verify Hyderabad and Bengaluru return accurate coordinates and city names
        in fallback mode, never defaulting to Coimbatore or None.
        """
        from requests import RequestException

        real_get = __import__("app.services.weather_service", fromlist=["requests"]).requests.get

        def fail_open_meteo_forecast(url, *args, **kwargs):
            if "api.open-meteo.com/v1/forecast" in str(url):
                raise RequestException("Simulated offline mode for fallback test")
            return real_get(url, *args, **kwargs)

        with patch("app.services.weather_service.requests.get", side_effect=fail_open_meteo_forecast):
            hyd = get_weather_data("Hyderabad")
            self.assertEqual(hyd["city"], "Hyderabad, Telangana")
            self.assertAlmostEqual(hyd["latitude"], 17.3850, places=3)
            self.assertAlmostEqual(hyd["longitude"], 78.4867, places=3)
            self.assertIn("Fallback", hyd["forecast_source"])
            self.assertNotEqual(hyd["city"], "Coimbatore, Tamil Nadu")

            bgl = get_weather_data("Bengaluru")
            self.assertEqual(bgl["city"], "Bengaluru, Karnataka")
            self.assertAlmostEqual(bgl["latitude"], 12.9716, places=3)
            self.assertAlmostEqual(bgl["longitude"], 77.5946, places=3)
            self.assertIn("Fallback", bgl["forecast_source"])
            self.assertNotEqual(bgl["city"], "Coimbatore, Tamil Nadu")


def wait_for_url(url, timeout=25):
    start = time.time()
    while time.time() - start < timeout:
        try:
            with urllib.request.urlopen(url, timeout=1) as res:
                if res.status == 200:
                    return True
        except Exception:
            time.sleep(0.5)
    return False


