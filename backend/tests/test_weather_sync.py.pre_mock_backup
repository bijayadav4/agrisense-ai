def test_playwright_weather_location_change_and_race_condition(weather_servers):
    """
    Playwright Browser Test:
    1. Select Hyderabad -> heading updates to Hyderabad, API called with Hyderabad.
    2. Fallback banner displayed.
    3. Race condition: Rapidly click Hyderabad then Bengaluru -> final state settles to Bengaluru.
    """
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        context = browser.new_context(viewport={"width": 1440, "height": 900})
        page = context.new_page()

        # Track intercepted weather requests
        weather_urls = []
        page.on("request", lambda req: weather_urls.append(req.url) if "/api/weather" in req.url else None)

        # Step 1: Open app and navigate to Weather tab
        page.goto("http://localhost:5173/", wait_until="networkidle")
        page.click("button:has-text('Weather & Forecast')")
        page.wait_for_timeout(1000)

        # Step 2: Click Hyderabad chip
        hyd_chip = page.locator("button.chip-btn:has-text('Hyderabad')")
        hyd_chip.click()
        page.wait_for_timeout(2000)

        # Assert heading contains Hyderabad
        climate_heading = page.locator("h3:has-text('Current Climate in')").inner_text()
        assert "Hyderabad" in climate_heading, f"Expected Hyderabad in heading, got '{climate_heading}'"

        # Assert fallback banner is present
        banner = page.locator("text=Regional baseline, not live")
        assert banner.is_visible(), "Expected fallback banner 'Regional baseline, not live' to be visible"

        # Assert request was sent for Hyderabad
        has_hyd_req = any("Hyderabad" in u for u in weather_urls)
        assert has_hyd_req, f"Expected /api/weather request for Hyderabad. Got: {weather_urls}"

        # Step 3: Rapid Race Condition Check (Hyderabad -> Bengaluru in quick succession)
        bgl_chip = page.locator("button.chip-btn:has-text('Bengaluru')")
        
        # Fire both clicks rapidly
        hyd_chip.click()
        bgl_chip.click()

        # Allow requests to settle
        page.wait_for_timeout(2500)

        # Assert final state is strictly Bengaluru
        final_heading = page.locator("h3:has-text('Current Climate in')").inner_text()
        assert "Bengaluru" in final_heading, f"Expected Bengaluru as final heading, got '{final_heading}'"
        assert "Hyderabad" not in final_heading, f"Stale Hyderabad response overwrote Bengaluru! Heading: '{final_heading}'"

        # Assert Header displays Bengaluru
        header_text = page.locator(".header-location h3").inner_text()
        assert "Bengaluru" in header_text, f"Header location expected Bengaluru, got '{header_text}'"

        browser.close()
