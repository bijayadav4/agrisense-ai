# ========================================================
# AgriSense AI — Environment Configuration Template
# ========================================================

# Flask Server Configuration
PORT=5000
FLASK_ENV=production
DEBUG=False

# Meteorological Services (Optional: Primary is Open-Meteo zero-key)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Frontend URL (for production CORS restriction if desired)
FRONTEND_URL=http://localhost:5173

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
